index 0000000000000000000000000000000000000000..e2b1cba698f6b2dca801d09054bb3b4f79e0d16c
--- /dev/null
+++ b/tests/test_codex_launcher.py
@@ -0,0 +1,244 @@
+#!/usr/bin/env python3
+"""Credential-free launcher routing/acknowledgement checks; no model requests."""
+import json
+import os
+from pathlib import Path
+import pty
+import select
+import shutil
+import signal
+import subprocess
+import tempfile
+import time
+import unittest
+
+SCRIPT = Path(__file__).resolve().parents[1] / 'bin/ai-singbox-codex'
+
+
+class LauncherTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix='jcodex-test-')
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        cli = self.root / '.local/bin/codex'
+        cli.parent.mkdir(parents=True)
+        self.bin = self.root / 'bin'
+        self.bin.mkdir()
+        self.script = self.bin / 'ai-singbox-codex'
+        shutil.copy2(SCRIPT, self.script)
+        self.log = self.root / 'calls.jsonl'
+        self.env = dict(os.environ, HOME=str(self.root),
+                        PATH=f'{self.bin}:/usr/bin:/bin', JCODEX_TEST_LOG=str(self.log))
+        self.env.pop('AI_SINGBOX', None)
+        self.env.pop('AI_SINGBOX_CODEX', None)
+        self.env['AI_SINGBOX_CONFIG_DIR'] = str(self.root / 'config')
+        init = self.root / 'init.sh'
+        init.write_text('''module() {
+  [[ "$-" != *u* ]] || return 91
+  printf '%s\\n' "$*" >> "$HOME/modules"
+  [[ "${JCODEX_TEST_MODULE_FAIL:-}" != 1 ]]
+}
+export -f module
+''')
+        self.env['BASH_ENV'] = str(init)
+        cli.write_text('''#!/bin/bash
+printf 'codex %s\\n' "$*" >> "$HOME/codex-calls"
+case "$1" in
+  --help) [[ "${JCODEX_TEST_OLD:-}" == 1 ]] || echo --no-daemon ;;
+  --version) echo codex-test ;;
+  *) exit 92 ;;
+esac
+''')
+        cli.chmod(0o700)
+        ai = self.bin / 'ai-singbox'
+        ai.write_text('''#!/usr/bin/python3
+import json, os, sys
+args = sys.argv[1:]
+if args == ['--version']:
+    print('ai-singbox 0.5.1-dev')
+    sys.exit(0)
+with open(os.environ['JCODEX_TEST_LOG'], 'a') as f:
+    f.write(json.dumps(args) + '\\n')
+if '--print-binds' in args:
+    if '--profile=bad' in args:
+        sys.exit(2)
+    print('MODE SOURCE DEST')
+    print('rw /scratch/user /scratch/user [$MYSCRATCH]')
+    print('rw /host/home /users/test [synthetic home]')
+    print('rw /scratch/tmp /tmp, /var/tmp')
+    if '--profile=empty' not in args:
+        print('ro /data/top /data/top [profile selected]')
+        print('ro /extra with spaces /extra with spaces [--read]')
+    print('ro (deny) /usr/bin/ssh')
+else:
+    print('CONTAINER_LAUNCH')
+''')
+        ai.chmod(0o700)
+        npm = self.bin / 'npm'
+        npm.write_text('#!/bin/bash\nprintf "%s\\n" "$*" > "$HOME/npm-calls"\n')
+        npm.chmod(0o700)
+
+    def calls(self):
+        if not self.log.exists():
+            return []
+        return [json.loads(line) for line in self.log.read_text().splitlines()]
+
+    def run_cli(self, *args):
+        return subprocess.run(['bash', str(self.script), *args], env=self.env,
+                              input='', text=True, capture_output=True, timeout=10)
+
+    def interactive(self, *args):
+        master, slave = pty.openpty()
+        proc = subprocess.Popen(['bash', str(self.script), *args], env=self.env,
+                                stdin=slave, stdout=subprocess.PIPE,
+                                stderr=subprocess.STDOUT, start_new_session=True)
+        os.close(slave)
+        self.addCleanup(os.close, master)
+        self.addCleanup(lambda: proc.poll() is None and proc.kill())
+        self.addCleanup(proc.stdout.close)
+        output = b''
+        deadline = time.monotonic() + 10
+        while b'Press Enter' not in output and time.monotonic() < deadline:
+            readable, _, _ = select.select([proc.stdout], [], [], 0.1)
+            if readable:
+                block = os.read(proc.stdout.fileno(), 4096)
+                if not block:
+                    break
+                output += block
+        self.assertIn(b'Press Enter', output, output)
+        self.assertEqual(len(self.calls()), 1, 'nothing launched before Enter')
+        return proc, master, output
+
+    def test_preview_lists_writes_and_configured_reads(self):
+        result = self.run_cli('--profile=selected', '--dry-run')
+        self.assertEqual(result.returncode, 0, result.stderr)
+        for value in ('WRITABLE', '/scratch/user', '/tmp, /var/tmp',
+                      'READ-ONLY', '/data/top', '/extra with spaces'):
+            self.assertIn(value, result.stderr)
+        self.assertNotIn('(deny)', result.stderr)
+        self.assertNotIn('Press Enter', result.stderr)
+        self.assertEqual(len(self.calls()), 1)
+        self.assertEqual((self.root / 'modules').read_text().splitlines(),
+                         ['load node'])
+        for value in (str(self.root / 'config/config'), 'profiles/default.conf',
+                      'write = /existing/path', '--write-here', '--write /existing/path'):
+            self.assertIn(value, result.stderr)
+
+    def test_write_here_is_explicit_current_directory_grant(self):
+        result = self.run_cli('--write-here', '--write', '/another/path', '--dry-run')
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.calls()[0][:4],
+                         ['--write', os.getcwd(), '--write', '/another/path'])
+        self.assertNotIn('--write', self.run_default_preview())
+
+    def run_default_preview(self):
+        self.run_cli('--dry-run')
+        return self.calls()[-1]
+
+    def test_explicit_cli_override(self):
+        original = self.root / '.local/bin/codex'
+        override = self.root / 'custom-codex'
+        original.rename(override)
+        self.env['AI_SINGBOX_CODEX'] = str(override)
+        result = self.run_cli('--dry-run')
+        self.assertEqual(result.returncode, 0, result.stderr)
+
+    def test_jcodex_alias_resolves_the_same_wrapper(self):
+        alias = self.bin / 'jcodex'
+        alias.symlink_to(self.script.name)
+        result = subprocess.run([str(alias), '--dry-run'], env=self.env,
+                                capture_output=True, text=True, timeout=10)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn('jcodex: ai-singbox 0.5.1-dev', result.stderr)
+
+    def test_enter_launches_and_preserves_arguments(self):
+        proc, master, output = self.interactive(
+            '--profile', 'project', '--write', '/project/output with spaces',
+            '--', 'resume', '--last', 'literal $(false); a b')
+        os.write(master, b'\n')
+        tail, _ = proc.communicate(timeout=10)
+        self.assertEqual(proc.returncode, 0, output + tail)
+        self.assertIn(b'CONTAINER_LAUNCH', tail)
+        self.assertEqual(self.calls()[-1], [
+            '--profile', 'project', '--write', '/project/output with spaces',
+            '--agent', 'codex', '--yolo', '--', '--no-daemon',
+            'resume', '--last', 'literal $(false); a b'])
+        self.assertEqual((self.root / 'codex-calls').read_text(), 'codex --help\n')
+
+    def test_nonempty_response_does_not_acknowledge(self):
+        proc, master, _ = self.interactive()
+        os.write(master, b'yes\n')
+        time.sleep(0.1)
+        self.assertEqual(len(self.calls()), 1)
+        self.assertIsNone(proc.poll())
+        os.write(master, b'\n')
+        proc.communicate(timeout=10)

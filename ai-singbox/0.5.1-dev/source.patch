@@ -0,0 +1,127 @@
+#!/bin/bash
+set -eo pipefail
+
+## use the wrapper shipped beside this launcher, including through the jcodex alias
+PROG=${0##*/}
+BIN_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
+WRAPPER=$BIN_DIR/ai-singbox
+
+usage() {
+  cat <<'HELP'
+Usage: ai-singbox-codex [sandbox options] [--] [Codex arguments...]
+
+Show folder access, require Enter, then start
+embedded Codex INSIDE Singularity with agent permission prompts disabled.
+Also available as: jcodex (after 'module load ai-singbox').
+
+Sandbox options (before Codex arguments):
+  --profile NAME       select an ai-singbox profile (repeatable; default: default)
+  --write PATH         existing writable folder (repeatable)
+  --write-here         add the current directory to writable folders
+  --read PATH          additional read-only folder (repeatable)
+  --home-dir DIR       select a persistent sandbox home
+  --home-mode MODE     synthetic | real-ro | real-rw
+  --module NAME        load a module inside the container (repeatable)
+  --no-scratch         disable the general writable scratch mount
+  --no-personal-libs   hide host R/Python libraries
+  --codex-seed DIR     copy settings into the sandbox (keeps existing files)
+  --seed-credentials   also copy login; shares its refresh token with the host
+  --reseed             overwrite previously seeded settings
+  --dry-run           show folder summary without acknowledging or starting
+  --update             update ~/.local Codex on the HOST, then exit
+  -h, --help           this help; use '-- --help' for Codex help
+
+Examples:
+  ai-singbox-codex --profile myproject
+  ai-singbox-codex --write-here
+  ai-singbox-codex --write /existing/project/output -- resume --last
+  ai-singbox-codex login --device-auth
+
+Codex uses the sandbox's own settings/login, not the host's CODEX_HOME.
+Use '--' to pass a conflicting option (e.g. Codex's --profile) to Codex.
+Writable subfolders are exceptions to the read-only parents shown below.
+Customize defaults in ~/.config/ai-singbox/config; persistent read/write paths
+belong in ~/.config/ai-singbox/profiles/NAME.conf (select with --profile NAME).
+Override the site default by copying $AI_SINGBOX_ROOT/etc/profiles/default.conf
+to ~/.config/ai-singbox/profiles/default.conf and editing the copy on the host.
+HELP
+}
+die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 2; }
+
+## parse sandbox options; remaining arguments belong to Codex unchanged
+sandbox_args=(); preview=0; update=0
+while (( $# )); do
+  case "$1" in
+    --profile|--write|--read|--home-dir|--home-mode|--module|--codex-seed)
+      (( $# >= 2 )) || die "$1 needs a value"
+      sandbox_args+=("$1" "$2"); shift 2 ;;
+    --profile=*|--write=*|--read=*|--home-dir=*|--home-mode=*|--module=*|--codex-seed=*)
+      sandbox_args+=("$1"); shift ;;
+    --no-scratch|--no-personal-libs|--seed-credentials|--reseed)
+      sandbox_args+=("$1"); shift ;;
+    --write-here) sandbox_args+=(--write "$(pwd -P)"); shift ;;
+    --dry-run) preview=1; shift ;;
+    --update) update=1; shift ;;
+    -h|--help) usage; exit 0 ;;
+    --) shift; break ;;
+    *) break ;;
+  esac
+done
+[[ -z "${AI_SINGBOX:-}" ]] || die 'already inside ai-singbox; run codex directly here'
+
+## updates affect only the user's copy; launches honor an explicit CLI override
+if (( update )); then
+  (( $# == 0 && ${#sandbox_args[@]} == 0 && preview == 0 )) || die '--update must be used alone'
+  module load node
+  npm install --global --prefix "$HOME/.local" @openai/codex@latest
+  exec "$HOME/.local/bin/codex" --version
+fi
+codex_bin=${AI_SINGBOX_CODEX:-}
+if [[ -z "$codex_bin" ]]; then
+  if [[ -x "$HOME/.local/bin/codex" ]]; then codex_bin="$HOME/.local/bin/codex"
+  else codex_bin=$(command -v codex || true); fi
+fi
+codex_bin=$(command -v -- "$codex_bin" || true)
+## Lmod must run without nounset; never fall back to a host session
+module load node
+set -u
+[[ -x "$codex_bin" ]] || die "Codex is missing; run $PROG --update on the host first"
+[[ "$("$codex_bin" --help)" == *--no-daemon* ]] || die "Codex lacks --no-daemon; run $PROG --update"
+export AI_SINGBOX_CODEX="$codex_bin"
+export AI_SINGBOX_ROOT="$(dirname "$BIN_DIR")"
+real_home=$(getent passwd "$(id -un)" | cut -d: -f6)
+config_dir=${AI_SINGBOX_CONFIG_DIR:-${real_home:-$HOME}/.config/ai-singbox}
+
+## use the installed wrapper to resolve profiles and validate every requested path
+launch=("$WRAPPER" "${sandbox_args[@]}" --agent codex --yolo)
+binds=$("${launch[@]}" --print-binds)
+{
+  printf '%s: %s; Codex starts inside Singularity\n' "$PROG" "$("$WRAPPER" --version)"
+  printf 'Sandbox options:'
+  if (( ${#sandbox_args[@]} )); then printf ' %q' "${sandbox_args[@]}"; else printf ' (default configuration)'; fi
+  printf '\n\nWRITABLE folders (host SOURCE -> DEST inside container):\n'
+  printf '%s\n' "$binds" | awk 'NR == 1 || $1 == "rw"'
+  printf '\nREAD-ONLY top folders from configuration (WRITABLE children above are exceptions):\n'
+  printf '%s\n' "$binds" | awk '
+    NR == 1 { print; next }
+    $1 == "ro" && /\[(profile [^]]+|config|--read)\]$/ { print; found=1 }
+    END { if (!found) print "  (none)" }
+  '
+  printf '\nSystem/shared software and host agent binaries are also read-only.\n'
+  printf '\nCustomize on the host before launching:\n'
+  printf '  defaults: %s/config (home, scratch, modules; writes belong in profiles)\n' "$config_dir"
+  printf '  profiles: %s/profiles/NAME.conf; select with --profile NAME\n' "$config_dir"
+  printf '  override default: copy %s/etc/profiles/default.conf to %s/profiles/default.conf\n' "$AI_SINGBOX_ROOT" "$config_dir"
+  printf '  profile entries: read = /path, write = /existing/path, include = default\n'
+  printf '  add writes for one run: %s --write-here or %s --write /existing/path (repeatable)\n' "$PROG" "$PROG"
+} >&2
+(( preview )) && exit 0
+
+## require an explicit empty line from a terminal; EOF or cancellation never launches
+[[ -t 0 ]] || die 'acknowledgement requires a terminal; use --dry-run to inspect'
+while true; do
+  printf '\nPress Enter to acknowledge and start singboxed Codex (Ctrl-C cancels): ' >&2
+  IFS= read -r reply || die 'acknowledgement cancelled'
+  [[ -z "$reply" ]] && break
+done
+exec "${launch[@]}" -- --no-daemon "$@"
